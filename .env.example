# Copy to .env and edit. .env is gitignored.

# ----- MQTT (Digitransit HSL high-frequency positioning) -----
# See https://digitransit.fi/en/developers/apis/4-realtime-api/vehicle-positions/
MQTT_BROKER_HOST=mqtt.hsl.fi
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=true
# Topic filter for Phase 1. Narrow to a few routes to keep volume sane.
# Example: route 550 in both directions.
# Topic shape: /hfp/v2/journey/ongoing/vp/<mode>/<op>/<veh>/<route>/<dir>/...
MQTT_TOPIC_FILTER=/hfp/v2/journey/ongoing/vp/+/+/+/550/#

# ----- Neo4j -----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ----- Kafka (Phase 2+) -----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_VP_RAW=vp-raw
KAFKA_TOPIC_DELAY_WINDOWS=route-delay-windows
KAFKA_CONSUMER_GROUP=transitgraph-consumer

# ----- App -----
LOG_LEVEL=INFO
# Comma-separated route shortNames to ingest in Phase 1. Empty = all.
ROUTE_FILTER=550,4,9
